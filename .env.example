# Copiar a .env.local y completar (NUNCA subir .env.local a git).
# En local: `pnpm env:local` lo genera a partir de `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La app NO usa la service_role key: toda operación va con el JWT del usuario y RLS.
